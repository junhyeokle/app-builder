{
  "appName": "운동 기록장",
  "slug": "workout-tracker",
  "resource": {
    "table": "workout_logs",
    "tsTypeName": "WorkoutLog",
    "libFileName": "workout-logs",
    "fields": [
      {
        "name": "exercise_name",
        "type": "text",
        "tsType": "string",
        "required": true
      },
      {
        "name": "reps",
        "type": "integer",
        "tsType": "number",
        "required": true
      },
      {
        "name": "sets",
        "type": "integer",
        "tsType": "number",
        "required": true
      },
      {
        "name": "workout_date",
        "type": "date",
        "tsType": "string",
        "required": true
      },
      {
        "name": "is_completed",
        "type": "boolean",
        "tsType": "boolean",
        "required": true,
        "default": false
      }
    ],
    "orderBy": [
      {
        "field": "workout_date",
        "ascending": false
      }
    ]
  },
  "screen": {
    "title": "오늘의 운동",
    "description": "운동 이름, 세트 수, 횟수, 날짜를 포함한 운동 기록 목록입니다. 각 항목을 추가하고, 완료 여부를 체크하거나 삭제할 수 있습니다."
  }
}